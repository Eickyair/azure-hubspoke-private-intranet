$ErrorActionPreference = 'Stop'

$desktopPath = 'C:\Users\Public\Desktop'
New-Item -ItemType Directory -Force -Path $desktopPath | Out-Null

$validationNotes = @(
    'Validacion manual - Private Intranet',
    '',
    'URLs internas:',
    'INTRANET: ${intranet_url}',
    'ADMIN: ${admin_url}',
    'API: ${api_url}',
    'ANALYTICS: ${analytics_url}',
    '',
    'Pruebas rapidas en PowerShell:',
    'Resolve-DnsName api.northwind.lab',
    'Resolve-DnsName kpi.northwind.lab',
    'Invoke-WebRequest ${api_url} -UseBasicParsing',
    '',
    'Acceso Azure con identidad administrada:',
    'az login --identity',
    'az resource list -g ${resource_group_name} --output table'
)

Set-Content -Path (Join-Path $desktopPath 'Private-Intranet-Checks.txt') -Value $validationNotes

try {
    $azureCliInstaller = Join-Path $env:TEMP 'AzureCLI.msi'
    Invoke-WebRequest -Uri 'https://aka.ms/installazurecliwindows' -OutFile $azureCliInstaller
    Start-Process msiexec.exe -ArgumentList '/I', $azureCliInstaller, '/quiet' -Wait
    Add-Content -Path (Join-Path $desktopPath 'Private-Intranet-Checks.txt') -Value ''
    Add-Content -Path (Join-Path $desktopPath 'Private-Intranet-Checks.txt') -Value 'Azure CLI instalado correctamente.'
}
catch {
    Add-Content -Path (Join-Path $desktopPath 'Private-Intranet-Checks.txt') -Value ''
    Add-Content -Path (Join-Path $desktopPath 'Private-Intranet-Checks.txt') -Value ('No se pudo instalar Azure CLI: ' + $_.Exception.Message)
}